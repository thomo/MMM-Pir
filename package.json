{
  "name": "MMM-Pir",
  "version": "3.0.0",
  "description": "Screen manager",
  "keywords": [
    "magic mirror",
    "module",
    "screen",
    "motion detection"
  ],
  "homepage": "https://github.com/thomo/MMM-Pir",
  "repository": {
    "type": "git",
    "url": "https://github.com/thomo/MMM-Pir"
  },
  "license": "MIT",
  "author": "bugsounet",
  "type": "commonjs",
  "main": "MMM-Pir.js",
  "scripts": {
    "clean": "rm -rf node_modules package-lock.json",
    "dependencies": "installer/dependencies.sh -d 'unclutter ddcutil cec-utils python3 python-is-python3 python3-gpiozero gpiod'",
    "dev": "cd installer && node dev.js",
    "dev:src": "cd installer && node src.js",
    "preinstall": "echo ⚠ npm install will be deprecated on next release!.",
    "install": "npm run setup",
    "postinstall": "echo ⚠ On next release, Please use: npm run setup",
    "lint": "eslint . --config eslint.config.mjs",
    "lint:fix": "eslint . --config eslint.config.mjs --fix",
    "pinctrl": "installer/pinctrl.sh",
    "rebuild": "installer/rebuild.sh",
    "reset": "rm -f *.js && rm -rf components/*.js && git reset --hard",
    "presetup": "npm run dependencies && installer/preinstall.sh",
    "setup": "npm prune",
    "postsetup": "installer/postinstall.sh -m -r",
    "test": "npm run lint",
    "test:minify": "cd installer && node minify.js",
    "update": "installer/update.sh"
  },
  "dependencies": {
    "@electron/rebuild": "^4.2.1",
    "cron-parser": "^4.9.0",
    "esbuild": "^0.28.2",
    "fdir": "^6.4.2",
    "lodash": "^4.18.1",
    "long-press-event": "^2.5.0",
    "node-cron": "^3.0.3",
    "progressbar.js": "^1.1.1",
    "python-shell": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-package-json": "^1.10.1",
    "globals": "^17.13.0"
  },
  "engines": {
    "node": ">=22.22.2 <23 || >=24"
  },
  "rev": "261015"
}
